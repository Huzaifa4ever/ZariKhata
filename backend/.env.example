# ---- database ----
# Local dev (docker-compose):
#   DATABASE_URL="mysql://zarikhata:zarikhata_dev_password@localhost:3306/zarikhata"
# Oracle MySQL HeatWave: take the private IP from the DB system's Connections
# tab. The backend VM reaches it over the VCN's private subnet, so the DB never
# needs a public IP.
DATABASE_URL="mysql://zarikhata:CHANGE_ME@10.0.1.5:3306/zarikhata"

PORT=4000
NODE_ENV=production

# Any long random string. Generate with: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_at_least_32_characters_long"

# Exact origin(s) of the frontend, comma-separated, no trailing slash.
# Cloudflare Pages gives you <project>.pages.dev; add your custom domain too.
CORS_ORIGINS="https://zarikhata.pages.dev"
